---
import UniLayout from '../../../layouts/UniLayout.astro';
import { simulazioni, urlOf } from '../../../lib/uni';
import { inlineTex } from '../../../lib/tex';

const tutte = await simulazioni();
const totale = tutte.reduce((s, m) => s + m.prove.length, 0);
---

<UniLayout title="Simulazioni · Note" description="Simulazioni delle prove intermedie del primo anno di Ingegneria Informatica a Trento, a tempo e con correzione." materia="simulazioni">
  <main class="sheet senza-indice" id="contenuto">
    <header class="registro-head">
      <dl class="note-meta">
        <div><a href="/uni/">Tutte le materie</a></div>
        <div><dt>Prove</dt><dd>{totale}</dd></div>
      </dl>
      <h1>Simulazioni</h1>
      <p class="sotto">Prove intermedie rifatte sul modello di quelle degli anni scorsi: stessa struttura, stessi punteggi, numeri nuovi. Ognuna ha il cronometro con la durata vera e la correzione chiusa sotto il testo, con la griglia dei punti per autocorreggersi.</p>
    </header>

    <ol class="registro">
      {tutte.map(({ hub, prove }) => (
        <li class="materia">
          <div class="materia-head">
            <h2><a href={urlOf(hub)}>{hub.data.materiaNome}</a></h2>
            <p>{prove.length} {prove.length === 1 ? 'prova' : 'prove'}</p>
            <a class="apri" href={`${urlOf(hub)}#esame`}>Regole dell’esame</a>
          </div>
          <ol class="voci">
            {prove.map((n, i) => (
              <li class="voce">
                <a href={urlOf(n)}>
                  <span class="n">{i + 1}</span>
                  <span class="t" set:html={inlineTex(n.data.title)} />
                  <span class="d">{n.data.durata ? `${n.data.durata} min` : ''}</span>
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </main>
</UniLayout>
