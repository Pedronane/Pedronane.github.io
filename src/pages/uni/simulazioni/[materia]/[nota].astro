---
import NotaPagina from '../../../../components/NotaPagina.astro';
import { simulazioni, slugOf } from '../../../../lib/uni';

export async function getStaticPaths() {
  const tutte = await simulazioni();
  return tutte.flatMap(({ hub, prove }) =>
    prove.map((nota, i) => ({
      params: { materia: hub.data.materia, nota: slugOf(nota) },
      props: { nota, prima: prove[i - 1], dopo: prove[i + 1] },
    })),
  );
}
---

<NotaPagina {...Astro.props} />
